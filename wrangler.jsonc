{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasidit-mexico",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "mexico.kasion.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Same D1 database as money.kasion.dev (kasidit-money). Schema and
  // migrations live in that repo; this Worker only reads/writes rows.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kasidit-money-db",
      "database_id": "7f58ec5b-24b8-4885-a838-67a6c1f6f6db"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "kasion-dev",
    "OWNER_MATCH": "kasidit"
  },
  "observability": { "enabled": true }
}
